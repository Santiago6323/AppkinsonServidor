# Copiar como .env (NO se sube a git) y completar.
# Valores seguros: openssl rand -hex 32   (solo letras y números)

# Token que la app envía como "Authorization: Bearer <token>"
APPKINSON_TOKEN=cambiar

# Base de datos
POSTGRES_DB=appkinson
POSTGRES_USER=appkinson
POSTGRES_PASSWORD=cambiar

# Red de Docker del nginx de la página web (docker network ls), p. ej. research-site-v2_web
# Pruebas en un PC: appkinson_local (ver docker-compose.local.yml)
RED_PROXY=research-site-v2_web

# Sub-ruta pública en el proxy (debe coincidir con nginx/appkinson.conf). Vacío en pruebas locales.
APPKINSON_RUTA_BASE=/appkinson

# Tamaño máximo por archivo (MB)
APPKINSON_TAMANO_MAX_MB=200

# Puerto local de Adminer (siempre en 127.0.0.1)
APPKINSON_ADMINER_PUERTO=8080

# Días que se conservan los respaldos diarios
APPKINSON_DIAS_RESPALDO=30
